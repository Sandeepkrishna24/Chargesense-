modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EV Charge Finder"

[[workflows.workflow]]
name = "EV Charge Finder"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd EV-Charge-Finderzip/EV-Charge-Finder && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
